# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated origins allowed by CORS (mobile apps do not need it, keep for web tools)
CORS_ORIGINS=*
LOG_LEVEL=info

# ---- Auth ----
# Use a long random string in production (openssl rand -hex 32)
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30

# ---- Existing FawtraSmart ERP database ----
# DB_CLIENT=mysql2 for production (same values as the ERP .env), or sqlite for the local dev DB
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fawtra
DB_USERNAME=root
DB_PASSWORD=
# Only used when DB_CLIENT=sqlite
DB_SQLITE_FILE=/absolute/path/to/database/database.sqlite

# ---- ERP web deployment (for asset URLs and photo uploads) ----
# Public base URL of the web version, used to build logo / avatar / employee photo URLs
ERP_PUBLIC_URL=http://127.0.0.1:8000
# Photos are uploaded to the ERP (POST {ERP_MEDIA_URL}/api/mobile-media), never stored on this server.
# ERP_MEDIA_URL defaults to ERP_PUBLIC_URL; ERP_MEDIA_TOKEN must equal MOBILE_MEDIA_TOKEN in the ERP's .env (16+ chars)
ERP_MEDIA_URL=
ERP_MEDIA_TOKEN=
# Sub folder of the ERP's public/ where mobile avatar uploads are stored (must stay uploads/avatars — the ERP accepts a fixed folder list)
AVATAR_UPLOAD_DIR=uploads/avatars

# ---- Cache (seconds) ----
CACHE_TTL_PERMISSIONS=60
CACHE_TTL_SETTINGS=300
CACHE_TTL_THEME=600
ERP_API_URL=

# ---- Clients section ----
# Laravel config(app.timezone) — every time the clients section writes uses it
APP_TIMEZONE=Asia/Riyadh
# Optional: neighborhood name from coordinates (same key as the ERP)
GOOGLE_MAPS_API_KEY=
# Same switch as FAWTRA_ENFORCE_SUBSCRIPTION in the ERP (402 when the subscription is not active)
ENFORCE_SUBSCRIPTION=true
