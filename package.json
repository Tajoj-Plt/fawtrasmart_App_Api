{
  "name": "mobile-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FawtraSmart mobile API — Node.js + Express (clean architecture) on top of the existing FawtraSmart ERP database",
  "main": "dist/interfaces/http/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/interfaces/http/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
