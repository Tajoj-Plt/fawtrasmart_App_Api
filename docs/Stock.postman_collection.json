								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Fill email and password. Stores data.accessToken into the collection variable token.",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"\",\n    \"password\": \"\",\n    \"device\": {\n        \"id\": \"postman\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.data && json.data.accessToken) {",
									"    pm.collectionVariables.set(\"token\", json.data.accessToken);",
									"    console.log(\"Token saved to collection variable.\");",
									"}"
								]
							}
						}
					]
				}
			]
